le": "Body", "type": "string"}, "cloth": {"default": "", "description": "服装风格、穿着、配饰（英文）", "title": "Cloth", "type": "string"}, "face": {"default": "", "description": "五官、肤色、标记（英文）", "title": "Face", "type": "string"}}, "title": "AppearanceCard", "type": "object"}, "EnrichedCharacter": {"properties": {"name": {"title": "Name", "type": "string"}, "gender": {"default": "unknown", "title": "Gender", "type": "string"}, "age": {"anyOf": [{"type": "integer"}, {"type": "null"}], "default": null, "title": "Age"}, "appearance": {"$ref": "#/$defs/AppearanceCard"}, "personality": {"title": "Personality", "type": "object"}, "catchphrase": {"default": "", "title": "Catchphrase", "type": "string"}}, "required": ["name", "appearance"], "title": "EnrichedCharacter", "type": "object"}}, "properties": {"characters": {"items": {"$ref": "#/$defs/EnrichedCharacter"}, "title": "Characters", "type": "array"}}, "required": ["characters"]}\n```\n', 'role': 'user'}], 'model': 'deepseek-v4-flash', 'max_tokens': 16384, 'n': 1, 'stream': False, 'temperature': 0.4}}
