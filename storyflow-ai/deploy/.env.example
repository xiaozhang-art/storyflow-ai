# === StoryFlow AI Configuration ===

# LLM Configuration (required)
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1

# Database
# Docker / production:
# DATABASE_URL=postgresql+asyncpg://storyflow:storyflow@localhost:5432/storyflow
# Local dev without Docker:
DATABASE_URL=sqlite+aiosqlite:///./storyflow.db

# Redis
# Docker / production:
# REDIS_URL=redis://localhost:6379/0
# Local dev without Docker:
REDIS_URL=memory://local

# Debug
DEBUG=true

# Image / Voice / Image-to-Video providers
# Use "mock" for local dev without API keys; use "dashscope" / "kling" in production
IMAGE_API_PROVIDER=mock
VOICE_API_PROVIDER=mock
I2V_API_PROVIDER=mock

# Storage
STORAGE_PATH=./storage

# Runtime
ENABLE_QUALITY=true
ENABLE_DIRECTOR=false

# Montage video engine
MONTAGE_ENABLED=true
MONTAGE_TTS_PROVIDER=auto
