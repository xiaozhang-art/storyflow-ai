# === StoryFlow AI Configuration ===

# LLM Configuration
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1

# Database
DATABASE_URL=postgresql+asyncpg://storyflow:storyflow@localhost:5432/storyflow

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant (optional, for V2 Runtime Memory)
QDRANT_URL=http://localhost:6333

# === Runtime Backend Selection ===
# LangGraph (v1.0, default): sequential pipeline
# Agent OS Runtime (v2.0): Hook + Memory + Skill + A2A
# StoryFlow Runtime (v3.0): EventBus + Blackboard + Artifact + Director + Planner + Quality
USE_RUNTIME=false
USE_V3_RUNTIME=false

# === Image Generation ===
COMFYUI_URL=http://localhost:8188
# V3 Adapter provider: comfyui | mock
IMAGE_API_PROVIDER=comfyui

# === Voice Generation ===
COSYVOICE_URL=http://localhost:50000
# V3 Adapter provider: cosyvoice | mock
VOICE_API_PROVIDER=cosyvoice

# === Video Generation ===
# V3 Adapter provider: ffmpeg | mock
VIDEO_API_PROVIDER=ffmpeg

# === Storage ===
STORAGE_PATH=./storage

# === Artifacts (V3 Runtime) ===
# Directory for intermediate artifacts (scripts, images, prompts, etc.)
ARTIFACT_PATH=./artifacts

# === V2 Runtime Settings (optional) ===
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# A2A_TRANSPORT=memory
# LLM_WORKER_CONCURRENCY=10
# GPU_WORKER_CONCURRENCY=2